# Copy this file to `.env` and adjust the values for your machine.
# `.env` is git-ignored and must never contain real secrets - everything
# prefixed with VITE_ is bundled into the JavaScript the browser downloads.

# Base URL of the Spring Boot REST API.
# Local backend default (Spring Boot runs on 8080 unless configured otherwise):
VITE_API_BASE_URL=http://localhost:8080/api
